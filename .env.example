# --- CMS (required for /admin to work in production) ---

# The admin password. Compared server-side only; never sent to the browser.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Long random string used to sign admin session cookies (any 32+ chars).
CMS_SESSION_SECRET=generate-a-long-random-string-here

# Vercel Blob storage token — powers CMS image uploads (media store).
# Dashboard → Storage → Create Blob store → connect to this project.
BLOB_READ_WRITE_TOKEN=

# Neon Postgres connection string — the CMS content database.
# neon.tech → create project → copy the pooled connection string.
# Tables auto-create on first publish (or run cms.sql manually).
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
